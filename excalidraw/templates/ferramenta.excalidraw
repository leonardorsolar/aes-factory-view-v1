      "link": null,
      "locked": false,
      "text": "Plugins agrupam capacidades como servidores MCP, skills, subagentes, regras e\nhooks para estender os agentes com funcionalidade customizada.",
      "fontSize": 27.753662234809042,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Plugins agrupam capacidades como servidores MCP, skills, subagentes, regras e hooks para estender os agentes com funcionalidade customizada.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "VJP_2RvF2rVuyUdrYaYxi",
      "type": "text",
      "x": 3477.3608940970685,
      "y": 232.6794001406289,
      "width": 761.779296875,
      "height": 75,
      "angle": 0,
