      "groupIds": [],
      "frameId": null,
      "index": "b0rHC",
      "roundness": null,
      "seed": 851954940,
      "version": 952,
      "versionNonce": 904004164,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "eas8MBMWqJFNHjNJVbUES",
          "type": "arrow"
        },
        {
          "id": "2RnBjnAXxsgXdQtUE8R6d",
