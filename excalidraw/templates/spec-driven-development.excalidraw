      "isDeleted": false,
      "boundElements": null,
      "updated": 1786489734637,
      "link": null,
      "locked": false,
      "text": "Pipeline AES: seu pipeline puxa mais pro lado do OpenSpec\n(PRD/TechSpec/Tasks como artefatos versionados), mas ainda não tem a\ncamada de disciplina de execução (TDD forçado, review em duas etapas) que o\nSuperpowers adiciona.",
      "fontSize": 40.65625,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Pipeline AES: seu pipeline puxa mais pro lado do OpenSpec (PRD/TechSpec/Tasks como artefatos versionados), mas ainda não tem a camada de disciplina de execução (TDD forçado, review em duas etapas) que o Superpowers adiciona.",
      "autoResize": false,
      "lineHeight": 1.25
    },
