      "link": null,
      "locked": false,
      "text": "Fases: brainstorming (socrático) → planning → TDD (red-green-refactor) →\nsubagent-driven execution → code review em duas etapas → debugging\nestruturado (4 fases, causa raiz antes do fix)",
      "fontSize": 42.781250000000036,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Fases: brainstorming (socrático) → planning → TDD (red-green-refactor) → subagent-driven execution → code review em duas etapas → debugging estruturado (4 fases, causa raiz antes do fix)",
      "autoResize": false,
      "lineHeight": 1.25
    },
