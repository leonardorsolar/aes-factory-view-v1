      "version": 147,
      "versionNonce": 1209121298,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790441466129,
      "link": null,
      "locked": false,
      "text": "Com publish.mode: never (o\npadrão), ela para na branch\nfeature/<slug>, sem push\nnem PR.",
