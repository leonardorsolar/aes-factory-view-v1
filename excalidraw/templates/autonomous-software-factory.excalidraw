    {
      "id": "20x07NTRZ4wgtDGdkkVsP",
      "type": "text",
      "x": -13045.997570219459,
      "y": 8439.07948908731,
      "width": 356.7596435546875,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
