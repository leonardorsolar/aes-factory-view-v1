    },
    {
      "id": "x-IcjKGTVdxNA9ZhWkOOM",
      "type": "text",
      "x": -11893.041149321072,
      "y": 5830.119884672614,
      "width": 1021.5977376302081,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2R",
      "roundness": null,
      "seed": 1163133134,
      "version": 395,
      "versionNonce": 736828370,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790441466128,
      "link": null,
      "locked": false,
      "text": "allow: defeitos verificados em código do próprio projeto, reproduzíveis antes da correção.\nstop: mudanças sensíveis à segurança, intenção de produto pouco clara, defeito que não reproduz.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "allow: defeitos verificados em código do próprio projeto, reproduzíveis antes da correção.\nstop: mudanças sensíveis à segurança, intenção de produto pouco clara, defeito que não reproduz.",
      "autoResize": false,
      "lineHeight": 1.25
    },
