      "versionNonce": 304846674,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790441466128,
      "link": null,
      "locked": false,
      "text": "Controla comentários públicos: mode (manual, criteria\nou never), require, max_per_run, tone e guidance.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Controla comentários públicos: mode (manual, criteria ou never), require, max_per_run, tone e guidance.",
