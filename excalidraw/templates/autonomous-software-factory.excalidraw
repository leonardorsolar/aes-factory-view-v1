      "updated": 1790514099831,
      "link": null,
      "locked": false,
      "text": "TRIAGEM\n   │\n   ├── Implement   → workflows.collect.implement\n   │\n   ├── Reply       → workflows.collect.reply\n   │   \n   ├── Close       → workflows.collect.close\n   │\n   └── workflows.pull-requests. Publish / Approve / Merge / Deploy\n                    ↓\n             autorização própria",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "TRIAGEM\n   │\n   ├── Implement   → workflows.collect.implement\n   │\n   ├── Reply       → workflows.collect.reply\n   │   \n   ├── Close       → workflows.collect.close\n   │\n   └── workflows.pull-requests. Publish / Approve / Merge / Deploy\n                    ↓\n             autorização própria",
      "autoResize": true,
      "lineHeight": 1.25
    },
