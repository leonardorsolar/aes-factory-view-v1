      "updated": 1790441466129,
      "link": null,
      "locked": false,
      "text": "Merge: o merge é sempre seu. A fábrica nunca aprova nem faz merge.\npublish.mode só vai até never ou draft-pr. Não existe opção de merge",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Merge: o merge é sempre seu. A fábrica nunca aprova nem faz merge.\npublish.mode só vai até never ou draft-pr. Não existe opção de merge",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
