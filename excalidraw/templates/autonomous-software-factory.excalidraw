      "index": "b0rHS",
      "roundness": null,
      "seed": 1994462532,
      "version": 913,
      "versionNonce": 1974284868,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "eas8MBMWqJFNHjNJVbUES",
