    {
      "id": "zyWmdNb-NN94i2Ok7Bpwt",
      "type": "text",
      "x": -12164.840359642385,
      "y": 6491.714099702384,
      "width": 1243.8389892578125,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1dV",
      "roundness": null,
      "seed": 51267538,
      "version": 572,
      "versionNonce": 552993550,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790513665584,
      "link": null,
      "locked": false,
      "text": "workflows.collect.implement.mode: manual — só corrige código com sua autorização explícita (\"sim, #N\"), nunca sozinha.\nworkflows.collect.reply.mode: manual — rascunha comentários em issues/PRs, mas só posta com sua aprovação.\nworkflows.collect.close.mode: after-merge — só comenta a correção e fecha a issue depois que o PR for mergeado, nunca antes.\nworkflows.pull-requests.approve/merge: never — regra fixa: a fábrica nunca aprova nem faz merge de PR; isso é sempre seu.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "workflows.collect.implement.mode: manual — só corrige código com sua autorização explícita (\"sim, #N\"), nunca sozinha.\nworkflows.collect.reply.mode: manual — rascunha comentários em issues/PRs, mas só posta com sua aprovação.\nworkflows.collect.close.mode: after-merge — só comenta a correção e fecha a issue depois que o PR for mergeado, nunca antes.\nworkflows.pull-requests.approve/merge: never — regra fixa: a fábrica nunca aprova nem faz merge de PR; isso é sempre seu.",
      "autoResize": true,
      "lineHeight": 1.25
    },
