      "text": "version: 1\n\n\nrepositories:\n    - id: app\n        provider: github\n        remote: owner/repository \n        worktree:\n\n\nsources:\n    - id: code-issues\n        provider: github\n        type: issue\n        scope: owner/repository\n\n\nworkflows:\n  collect:\n    enabled: false # ligue quando a fonte acima estiver conectada\n    sources: [code-issues]\n    implement:\n        mode:\n        allow:\n        stop:\n    publish:\n     \n\n\n\n\n    reply:\n     \n\n    close:\n      \n\n  human-digest:\n    \n  pull-requests:\n    \n    review:\n     \n    approve:\n    \n    merge:\n     \n  pr-babysitting:\n   \n    fix:\n      \n    publish:\n     \n    reply:\n      \n    approve:\n      \n    merge:\n      \n    soak: none\n",
      "fontSize": 18.024218750000003,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "version: 1\n\n\nrepositories:\n    - id: app\n        provider: github\n        remote: owner/repository \n        worktree:\n\n\nsources:\n    - id: code-issues\n        provider: github\n        type: issue\n        scope: owner/repository\n\n\nworkflows:\n  collect:\n    enabled: false # ligue quando a fonte acima estiver conectada\n    sources: [code-issues]\n    implement:\n        mode:\n        allow:\n        stop:\n    publish:\n     \n\n\n\n\n    reply:\n     \n\n    close:\n      \n\n  human-digest:\n    \n  pull-requests:\n    \n    review:\n     \n    approve:\n    \n    merge:\n     \n  pr-babysitting:\n   \n    fix:\n      \n    publish:\n     \n    reply:\n      \n    approve:\n      \n    merge:\n      \n    soak: none\n",
      "lineHeight": 1.25,
