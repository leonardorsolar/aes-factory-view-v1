      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Se quiser uma trava real, ela teria de vir do GitHub, com branch protection exigindo review humano para mergear na main.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "EEgNCWnAmXMw4JLEAi5g7",
      "type": "text",
      "x": -9707.47818138489,
      "y": 3527.470796130958,
      "width": 859.97216796875,
      "height": 48.50585937500011,
      "angle": 0,
