      "versionNonce": 240930894,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790445501259,
      "link": null,
      "locked": false,
      "text": "Sobre Revisão da PR:\nComo uma agente pode revisar tudo,\ncheca CI e decide (via política de\naprovação) se pode fazer merge\nautomático ou se precisa de revisão\nhumana?",
      "fontSize": 34.505212953183054,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sobre Revisão da PR:\nComo uma agente pode revisar tudo, checa CI e decide (via política de aprovação) se pode fazer merge automático ou se precisa de revisão humana?",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
