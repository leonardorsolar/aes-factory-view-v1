    },
    {
      "id": "R23GomB7WBNsOlvpVWjbb",
      "type": "text",
      "x": -1148.8904854911525,
      "y": 4725.448521205361,
      "width": 404.353515625,
      "height": 105,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3j",
      "roundness": null,
      "seed": 1081859858,
      "version": 118,
      "versionNonce": 185903698,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790441959799,
      "link": null,
      "locked": false,
      "text": "Com a sua aprovação,\ncomenta a correção na issue\ne limpa o worktree.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Com a sua aprovação, comenta a correção na issue e limpa o worktree.",
