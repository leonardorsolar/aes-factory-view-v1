    {
      "id": "9wBKU9m6nVDb4vgtiN1D9",
      "type": "text",
      "x": -2825.892382667258,
      "y": 4847.291620163696,
      "width": 717.642822265625,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3WG",
      "roundness": null,
      "seed": 950214802,
      "version": 514,
      "versionNonce": 701248402,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790513091070,
      "link": null,
      "locked": false,
      "text": "Lê o estado real do PR no GitHub e o diff. \nReporta achados com arquivo, linha, impacto \ne correção. Com review.post: manual, não posta: \nmostra o texto e pergunta \"post review on PR #N?\".",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Lê o estado real do PR no GitHub e o diff. \nReporta achados com arquivo, linha, impacto \ne correção. Com review.post: manual, não posta: \nmostra o texto e pergunta \"post review on PR #N?\".",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "-pwPj8WLtMQbMTH7J9NSy",
      "type": "text",
      "x": -2811.0759764172576,
      "y": 4282.169224330361,
      "width": 617.7664794921875,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3WO",
      "roundness": null,
      "seed": 825924942,
      "version": 497,
      "versionNonce": 818305874,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790441466130,
      "link": null,
      "locked": false,
      "text": "Use factory-babysit-pr quando há achados \na corrigir, ou checks e comentários chegando \nao longo do tempo. Ele acompanha um PR \nsó e o ciclo se repete a cada passada.\n",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Use factory-babysit-pr quando há achados \na corrigir, ou checks e comentários chegando \nao longo do tempo. Ele acompanha um PR \nsó e o ciclo se repete a cada passada.\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
