    {
      "id": "YgBnD50zo63Gyep0locLn",
      "type": "text",
      "x": 8347.49357096354,
      "y": 1559.8555617559487,
      "width": 984.8357747395834,
      "height": 450,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0mV",
      "roundness": null,
      "seed": 1441954244,
      "version": 163,
      "versionNonce": 2184388,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790361515936,
      "link": null,
      "locked": false,
      "text": "O agente então:\n\nCria o repositório da fábrica e sobe pro GitHub\nPede 3 segredos (API key da Upstash, token fine-\ngrained do GitHub com permissão de\ncontents/issues/pull-requests, e o OAuth token do\nClaude Code)\nCria boxes de teste, configura os GitHub\nActions/triggers, e pede pra você dar merge nos PRs\nque conectam seus repositórios à fábrica",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "O agente então:\n\nCria o repositório da fábrica e sobe pro GitHub\nPede 3 segredos (API key da Upstash, token fine-grained do GitHub com permissão de contents/issues/pull-requests, e o OAuth token do Claude Code)\nCria boxes de teste, configura os GitHub Actions/triggers, e pede pra você dar merge nos PRs que conectam seus repositórios à fábrica",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "emIbiKzITtIMGpMJsxcHS",
      "type": "text",
      "x": 306.1266886393205,
