      "seed": 245222865,
      "version": 873,
      "versionNonce": 1768751601,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790605505985,
      "link": null,
      "locked": false,
      "text": "one-call chama aes-one-call-ai-native.\nfull-flow chama sdlc-intent\nclarify usa a regra reply.\npark só registra.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "one-call chama aes-one-call-ai-native.\nfull-flow chama sdlc-intent\nclarify usa a regra reply.\npark só registra.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "atTxMmUGtE4TRG0VLchFA",
      "type": "text",
      "x": -12168.43897646946,
      "y": 7772.623325892865,
      "width": 708.270948621961,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4Xl",
      "roundness": null,
      "seed": 1411736927,
      "version": 781,
      "versionNonce": 1429838801,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790605505985,
      "link": null,
      "locked": false,
      "text": "dois filtros, em palavras simples\nallow = \"o que eu deixo rodar sozinho\". Hoje: só defeitos verificados.\nstop = \"o que eu nunca deixo rodar sozinho\", mesmo que passe no allow.\nExemplo: mexe em segurança.\nExecuta somente se passar no allow e não cair no stop.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "dois filtros, em palavras simples\nallow = \"o que eu deixo rodar sozinho\". Hoje: só defeitos verificados.\nstop = \"o que eu nunca deixo rodar sozinho\", mesmo que passe no allow. Exemplo: mexe em segurança.\nExecuta somente se passar no allow e não cair no stop.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "6uK4cc4BmN0vOEcJL0uLF",
      "type": "text",
      "x": -13124.49366396946,
      "y": 7319.883370535722,
      "width": 1122.9919307648174,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
