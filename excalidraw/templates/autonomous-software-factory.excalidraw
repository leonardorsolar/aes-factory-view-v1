      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Com publish.mode: never (o padrão), ela para na branch feature/<slug>, sem push nem PR.",
      "autoResize": false,
      "lineHeight": 1.25
    },
