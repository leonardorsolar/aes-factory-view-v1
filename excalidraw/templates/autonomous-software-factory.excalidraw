      "isDeleted": false,
      "boundElements": null,
      "updated": 1790441466129,
      "link": null,
      "locked": false,
      "text": "Se quiser uma trava real, ela teria de vir do GitHub, com branch protection\nexigindo review humano para mergear na main.",
      "fontSize": 20,
