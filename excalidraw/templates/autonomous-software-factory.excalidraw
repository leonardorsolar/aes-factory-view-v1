      "updated": 1790417980977,
      "link": null,
      "locked": false,
      "text": "B-implement:\n      mode: manual # Etapa A: só reporta. Troque para criteria ao liberar a correção automática (Etapa B)\n      max_per_run: 1\n      allow: [defeitos verificados em código do próprio projeto, reproduzíveis antes da correção]\n      stop: [mudanças sensíveis à segurança, intenção de produto pouco clara, defeito que não reproduz]\n    publish:\n      mode: never",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "B-implement:\n      mode: manual # Etapa A: só reporta. Troque para criteria ao liberar a correção automática (Etapa B)\n      max_per_run: 1\n      allow: [defeitos verificados em código do próprio projeto, reproduzíveis antes da correção]\n      stop: [mudanças sensíveis à segurança, intenção de produto pouco clara, defeito que não reproduz]\n    publish:\n      mode: never",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
