    {
      "id": "gqJ4jSU4DEM5KuketSDJr",
      "type": "text",
      "x": 6830.859455411397,
      "y": 1422.2846757192492,
      "width": 301.6988551712036,
      "height": 229.64843750000003,
      "angle": 0,
      "strokeColor": "#1971c2",
