      "isDeleted": false,
      "boundElements": null,
      "updated": 1786454790932,
      "link": null,
      "locked": false,
      "text": "instruções = uma linha pode conter zero ou várias instruções",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "instruções = uma linha pode conter zero ou várias instruções",
