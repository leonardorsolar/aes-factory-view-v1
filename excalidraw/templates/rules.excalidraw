      "versionNonce": 1644920794,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786457015408,
      "link": null,
      "locked": false,
      "text": "Sempre que\nprecisar de uma\nblbioteca use\nconetxt7 que tem a\ndocumentação\natualizada",
      "fontSize": 36.743750000000006,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sempre que  precisar de uma blbioteca use conetxt7 que tem a documentação atualizada",
