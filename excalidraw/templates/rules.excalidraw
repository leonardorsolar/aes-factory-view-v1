      "index": "b1F",
      "roundness": null,
      "seed": 1025317958,
      "version": 156,
      "versionNonce": 1627067590,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786456408395,
      "link": null,
      "locked": false,
      "text": "A técnica é: extrair só as 3-5 regras que o\nagente precisa aplicar em toda tarefa, e\napontar o resto para o arquivo de origem ",
      "fontSize": 32.172916666666666,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A técnica é: extrair só as 3-5 regras que o agente precisa aplicar em toda tarefa, e apontar o resto para o arquivo de origem ",
      "autoResize": false,
      "lineHeight": 1.25
    },
