    {
      "id": "Q7ff6IaHVMMEfKgf7yAaw",
      "type": "text",
      "x": 9863.272012377543,
      "y": 2094.579597594249,
      "width": 692.6761800511675,
      "height": 40.21614583333333,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
