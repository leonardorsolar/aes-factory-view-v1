      "isDeleted": false,
      "boundElements": null,
      "updated": 1786456386599,
      "link": null,
      "locked": false,
      "text": "O modelo agora\npode decidir a\nreal necessidade\nde obter mais\ninformações ",
      "fontSize": 36.743750000000006,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "O modelo agora pode decidir a real necessidade de obter mais informações ",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "Dw5VJoNMFON9mXnBbQp9e",
      "type": "text",
      "x": 8675.498574877543,
      "y": 1422.0893632192492,
      "width": 692.6761800511675,
      "height": 120.64843749999999,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
