      "link": null,
      "locked": false,
      "text": "🟠 Tool / function\n\nQuando: o agente invoca a função\nDá: uma ação que executa e retorna\nÉ o próprio código chamável",
      "fontSize": 31.633035714285764,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 13,
      "containerId": null,
      "originalText": "🟠 Tool / function\n\nQuando: o agente invoca a função\nDá: uma ação que executa e retorna\nÉ o próprio código chamável",
      "lineHeight": 1.25,
      "index": "b0z8",
      "autoResize": false
    },
