    {
      "id": "vMnY4PdDgJudtmSuBCBd6",
      "type": "text",
      "x": 9015.687046021056,
      "y": 5069.331194196428,
      "width": 1016.3172200393678,
      "height": 146.7316218855541,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
