      "isDeleted": false,
      "boundElements": null,
      "updated": 1790681436061,
      "link": null,
      "locked": false,
      "text": "a pessoa descreve o que quer, por que quer\ne quais são os limites, sem precisar seguir\nnenhum formato ou requisito formal. Uma\nespécie de rascunho de especificação",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "a pessoa descreve o que quer, por que quer e quais são os limites, sem precisar seguir nenhum formato ou requisito formal. Uma espécie de rascunho de especificação",
      "autoResize": false,
      "lineHeight": 1.25
    },
