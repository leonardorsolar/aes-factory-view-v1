      "updated": 1790166394114,
      "link": null,
      "locked": false,
      "text": "#### Schema de Banco\n```sql\nCREATE TABLE [tabela] (\n  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n  -- campos\n  created_at TIMESTAMP DEFAULT NOW()\n);\n```",
      "fontSize": 20.932700892857152,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "#### Schema de Banco\n```sql\nCREATE TABLE [tabela] (\n  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n  -- campos\n  created_at TIMESTAMP DEFAULT NOW()\n);\n```",
      "lineHeight": 1.25,
      "index": "b0V",
      "autoResize": false
    },
