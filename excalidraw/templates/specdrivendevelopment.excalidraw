    {
      "id": "e2MufQgUhZT9S6FYERNgt",
      "type": "text",
      "x": 11295.030235773866,
      "y": 7202.471031005547,
      "width": 889.713395995182,
      "height": 284.76106770833377,
      "angle": 0,
      "strokeColor": "#9c36b5",
