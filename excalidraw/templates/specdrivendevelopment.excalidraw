    {
      "id": "xLvBhaAk366Q1-oRAepWr",
      "type": "text",
      "x": 746.3536667596745,
      "y": 376.71740141369855,
      "width": 703.9990234375,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
