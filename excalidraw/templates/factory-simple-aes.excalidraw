  {
   "id": "AIAbrmmfThSCHjl6FhW0O",
   "type": "text",
   "x": -5964.422821408216,
   "y": -98.29957217261608,
   "width": 874.15234375,
   "height": 270,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
