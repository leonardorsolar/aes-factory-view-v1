   "isDeleted": false,
   "boundElements": null,
   "updated": 1794422037062,
   "link": null,
   "locked": false,
   "text": "Imagine uma fábrica de software que recebe pedidos e precisa transformá-los em software pronto.",
   "fontSize": 70.00000000000003,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Imagine uma fábrica de software que recebe pedidos e precisa transformá-los em software pronto.",
   "autoResize": false,
   "lineHeight": 1.25
  },
  {
   "id": "_fLrhadm-L3k0WuPizfTw",
   "type": "text",
   "x": -11645.222069149917,
   "y": -550.9965122767826,
   "width": 3379.4659423828143,
   "height": 700.0000000000002,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "b1TV",
   "roundness": null,
   "seed": 938157241,
   "version": 238,
   "versionNonce": 118818359,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1794422213798,
   "link": null,
   "locked": false,
   "text": "Para entregar isso, a fábrica precisa passar por várias etapas:\n1. Analisar o pedido.\n2. Criar a especificação.\n3. Desenvolver o código.\n4. Revisar o código.\n5. Corrigir os problemas.\n6. Executar os testes.\n7. Entregar o resultado.",
   "fontSize": 70.00000000000003,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Para entregar isso, a fábrica precisa passar por várias etapas:\n1. Analisar o pedido.\n2. Criar a especificação.\n3. Desenvolver o código.\n4. Revisar o código.\n5. Corrigir os problemas.\n6. Executar os testes.\n7. Entregar o resultado.",
   "autoResize": false,
   "lineHeight": 1.25
  },
  {
