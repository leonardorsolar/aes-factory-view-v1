   "link": null,
   "locked": false,
   "text": "Sua função é receber a orientação do motor\ne executar o que foi solicitado.",
   "fontSize": 79.37499999999997,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Sua função é receber a orientação do motor e executar o que foi solicitado.",
   "autoResize": false,
   "lineHeight": 1.25
  },
  {
   "id": "XWzH8F-Zxf4w5V4V7kzOn",
   "type": "text",
   "x": -12431.766726539197,
   "y": 6891.802966889881,
   "width": 2709.4676738315165,
   "height": 595.3124999999998,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "#ffec99",
   "fillStyle": "solid",
   "strokeWidth": 4,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
