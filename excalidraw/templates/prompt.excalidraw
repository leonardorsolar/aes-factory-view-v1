      "versionNonce": 874120096,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786398530872,
      "link": null,
      "locked": false,
      "text": "Context engineering = a engenharia de dar um bom ambiente de informação para o\nLLM — tudo que ele precisa saber para executar essa instrução corretamente",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
