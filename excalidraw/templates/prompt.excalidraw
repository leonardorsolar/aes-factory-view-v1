      "locked": false,
      "text": "LLM (modelo de linguagem)\nprevê a próxima palavra",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "LLM (modelo de linguagem) prevê a próxima palavra",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "_hpDumWQi4Y5jSSuiHnQN",
      "type": "text",
      "x": 2181.498142787388,
      "y": 584.5920758928571,
      "width": 791.5394287109375,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b36",
      "roundness": null,
      "seed": 139973803,
      "version": 220,
      "versionNonce": 764214880,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786398530872,
      "link": null,
      "locked": false,
      "text": "O modelo de IA não \"sabe\" a resposta certa — ele calcula, com base em tudo que\naprendeu, qual palavra é mais provável de vir a seguir.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "O modelo de IA não \"sabe\" a resposta certa — ele calcula, com base em tudo que aprendeu, qual palavra é mais provável de vir a seguir.",
      "autoResize": false,
      "lineHeight": 1.25
    },
